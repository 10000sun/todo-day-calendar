<?xml version="1.0" encoding="utf-8"?>
<!-- 구글 계정 자동 백업/기기 이전에 일정 DB와 설정만 포함 (Android 12+) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cal.db" />
        <include domain="sharedpref" path="guide.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cal.db" />
        <include domain="sharedpref" path="guide.xml" />
    </device-transfer>
</data-extraction-rules>
